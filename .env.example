# Copy to .env to override sidecar defaults. All keys take the ARIA_ prefix.
# Electron sets ARIA_TOKEN, ARIA_HOST, ARIA_PORT, ARIA_DEV and ARIA_DATA_DIR on
# spawn, so those only matter when running `npm run sidecar` standalone.

# ARIA_HOST=127.0.0.1        # never bind anything but loopback (BUILD_SPEC §11)
# ARIA_PORT=8765
# ARIA_DEV=false             # pretty console logs when true
# ARIA_LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR
# ARIA_DATA_DIR=./data

# ARIA_TOKEN is the WebSocket bearer token. Leave it unset: the sidecar mints
# one and writes it to data/.handshake. Never commit a value here.
# ARIA_TOKEN=

# API keys do NOT belong in this file. BUILD_SPEC §11 puts them in Windows
# Credential Manager via keyring, from Phase 6 onward.
