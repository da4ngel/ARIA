{
  "name": "aria",
  "version": "0.1.2",
  "description": "Local-first Windows AI assistant. Electron UI + Python sidecar brain.",
  "author": "Eyaas",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "sidecar": ".venv\\Scripts\\python.exe -m sidecar.main",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:sidecar": "python -m PyInstaller packaging/sidecar.spec --noconfirm --distpath packaging/dist --workpath packaging/build",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "framer-motion": "^11.0.0",
    "highlight.js": "^11.11.2",
    "jsdom": "^25.0.0",
    "lowlight": "^3.3.0",
    "postcss": "^8.4.47",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "unist-util-visit": "^5.1.0",
    "vite": "^5.3.0",
    "vitest": "^2.1.0",
    "zustand": "^4.5.0"
  }
}
